{
  "name": "fetchly-media-downloader",
  "version": "1.0.0",
  "description": "All-in-One Social Media Video & Audio Downloader with Neo-Brutalist UI",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-port.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --port 3000",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
